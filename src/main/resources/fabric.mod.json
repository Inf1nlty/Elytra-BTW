{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Add Elytra — functionality based on vanilla",
  "authors": [
    "Inf1nlty"
  ],
  "contact": {
    "homepage": "https://github.com/Inf1nlty/Elytra-BTW",
    "sources": "https://github.com/Inf1nlty/Elytra-BTW"
  },
  "license": "MIT",
  "icon": "assets/elytra/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
    ],
    "btw:addon": [
      "btw.community.elytra.ElytraAddon"
    ]
  },
  "custom": {
    "btw:addon_prefix": "ELY"
  },
  "mixins": [
    "elytra.mixins.json"
  ],
  "accessWidener" : "elytra.accessWidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "${minecraft_version}",
    "btw": ">=${btw_version}"
  }
}
